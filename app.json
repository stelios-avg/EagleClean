{
  "expo": {
    "name": "Cleanovox",
    "slug": "EagleClean",
    "scheme": "eagleclean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.eagleclean.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#30CCCC",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Το Cleanovox χρησιμοποιεί τη θέση σου για να συμπληρώσει τη διεύθυνση και να επιβεβαιώσει ότι βρίσκεσαι στην περιοχή εξυπηρέτησης (Λευκωσία)."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ]
  }
}
